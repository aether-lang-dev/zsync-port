// zsyncmake entry point — thin CLI over cmd.mklib.

import std.string (
    string_concat, string_length, string_char_at, string_equals,
    string_substring, string_try_long, string_get_long
)
import std.os (*)
import std.fs
import std.io
import std.bytes
import cmd.mklib
import rcksum.fileio

VERSION() -> string {
    return "0.7.1"
}

main() {
    argc = aether_args_count()
    blocksize = 0
    out = ""
    url = ""
    fname = ""
    input = ""
    verbose = 0
    i = 1
    while i < argc {
        a = aether_args_get(i)
        if string_equals(a, "-b") == 1 {
            i = i + 1
            blocksize = parse_int_arg(aether_args_get(i))
        } else if string_equals(a, "-o") == 1 {
            i = i + 1
            out = aether_args_get(i)
        } else if string_equals(a, "-u") == 1 {
            i = i + 1
            url = aether_args_get(i)
        } else if string_equals(a, "-f") == 1 {
            i = i + 1
            fname = aether_args_get(i)
        } else if string_equals(a, "-v") == 1 {
            verbose = 1
        } else if string_equals(a, "-V") == 1 {
            println("zsyncmake v${VERSION()}")
            exit(0)
        } else if string_equals(a, "-e") == 1 {
            // no-op (compat)
        } else if string_equals(a, "-z") == 1 {
            // no-op (compat)
        } else if string_equals(a, "-Z") == 1 {
            // no-op (compat)
        } else {
            input = a
        }
        i = i + 1
    }

    // Input: a named file, or stdin when no file argument is given
    // (matching the Go tool). mtime is only known for a real file — for
    // stdin we leave it empty, so no MTime header is written (this is
    // also the correct behaviour Go's stdin path got wrong: it read a nil
    // FileInfo's ModTime and panicked).
    is_stdin = 0
    data = ""
    dlen = 0
    mtime = ""
    if string_equals(input, "") == 1 {
        is_stdin = 1
        data, dlen = read_stdin()
    } else {
        de = ""
        data, dlen, de = fs.read_binary(input)
        if de != "" {
            println("open: ${de}")
            exit(2)
        }
        epoch, merr = fs.mtime(input)
        if merr == "" {
            mtime = fileio.rfc1123z(epoch)
        }
    }

    if blocksize == 0 {
        if dlen < 100000000 {
            blocksize = 2048
        } else {
            blocksize = 4096
        }
    }
    if fname == "" && is_stdin == 0 {
        fname = basename(input)
    }
    // No -u given: include a *relative* URL (the input basename) so the
    // .zsync is still usable when served next to the data file, matching
    // Go. The client then needs the file served alongside it, or a `-u`
    // base to resolve against. (Not possible for stdin — no filename.)
    if string_equals(url, "") == 1 && is_stdin == 0 {
        url = basename(input)
        io.stderr_write("No URL given; including a relative URL. Serve the data file and .zsync from the same directory, or pass -u.\n")
    }
    // Output: -o, else <fname>.zsync when a filename is known, else stdout
    // (the stdin-with-no-name case). Matches Go.
    if string_equals(out, "") == 1 {
        if string_equals(fname, "") == 0 {
            out = string_concat(fname, ".zsync")
        }
    }

    content, clen = mklib.generate_n(data, dlen, blocksize, fname, mtime, url)

    if string_equals(out, "") == 1 {
        // write the (binary) control file to stdout, length-explicit so
        // the checksum table's NUL bytes survive
        if io.fd_write(1, fileio.view(content, clen)) != 0 {
            println("write: stdout")
            exit(2)
        }
    } else {
        werr = fs.write_binary(out, fileio.view(content, clen))
        if werr != "" {
            println("write: ${werr}")
            exit(2)
        }
    }
    if verbose == 1 {
        // to stderr so it doesn't corrupt a stdout .zsync
        io.stderr_write("Created .zsync with ${dlen / blocksize} blocks\n")
    }
}

// Read all of stdin (fd 0) into a binary-safe buffer. Returns (data, len).
read_stdin() -> (string, int) {
    buf = bytes.new(65536)
    total = 0
    done = 0
    while done == 0 {
        chunk, cnt, rerr = io.fd_read_n(0, 65536)
        if rerr != "" {
            io.stderr_write("read stdin: ${rerr}\n")
            exit(2)
        }
        if cnt == 0 {
            done = 1
        } else {
            bytes.copy_from_string(buf, total, chunk, cnt)
            total = total + cnt
        }
    }
    return bytes.finish(buf, total), total
}

parse_int_arg(s: string) -> int {
    ok = string_try_long(s)
    if ok == 0 {
        return 0
    }
    return string_get_long(s)
}

// last path component of a path
basename(p: string) -> string {
    n = string_length(p)
    last = 0 - 1
    i = 0
    while i < n {
        if (string_char_at(p, i) & 0xff) == 47 {   // '/'
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return p
    }
    return string_substring(p, last + 1, n)
}
