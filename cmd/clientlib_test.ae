// SPDX-FileCopyrightText: 2004,2005,2007,2009,2025,2026 Colin Phipps <cph@moria.org.uk>
// SPDX-License-Identifier: Artistic-2.0
//
// Unit tests for the per-host auth map (-A host=user:pass) and the URL
// host extractor it keys on. Mirrors the Go authMap behaviour: a
// credential applies only to requests whose host matches.

import std.string (
    string_equals
)
import std.fs
import std.string
import cmd.clientlib
import test.assert

main() {
    println("=== clientlib per-host auth ===")
    h = assert.new()

    // host_of: scheme strip, port strip, path/query/fragment cutoff.
    assert.eq_str(h, clientlib.host_of("http://example.com/a/b.zsync"), "example.com", "host: plain")
    assert.eq_str(h, clientlib.host_of("https://example.com/x"), "example.com", "host: https")
    assert.eq_str(h, clientlib.host_of("http://example.com:8080/x"), "example.com", "host: port stripped")
    assert.eq_str(h, clientlib.host_of("http://host.example.com"), "host.example.com", "host: no path")
    assert.eq_str(h, clientlib.host_of("http://h.io:9/p?q=1"), "h.io", "host: port+query")
    assert.eq_str(h, clientlib.host_of("http://h.io/p#frag"), "h.io", "host: fragment")
    assert.eq_str(h, clientlib.host_of("/local/path.zsync"), "", "host: local path -> empty")
    assert.eq_str(h, clientlib.host_of("ftp://x.com/y"), "", "host: non-http scheme -> empty")

    // auth_map_add: malformed specs rejected.
    m = clientlib.auth_map_new()
    assert.eq_int(h, clientlib.auth_map_add(m, "noequals"), 0, "reject: no '='")
    assert.eq_int(h, clientlib.auth_map_add(m, "host=nocolon"), 0, "reject: no ':'")
    assert.eq_int(h, clientlib.auth_map_add(m, "=user:pass"), 0, "reject: empty host")

    // Two hosts, distinct credentials (the whole point of the map).
    assert.eq_int(h, clientlib.auth_map_add(m, "a.example.com=bob:secret"), 1, "add a.example.com")
    assert.eq_int(h, clientlib.auth_map_add(m, "b.example.com=alice:pw123"), 1, "add b.example.com")

    // Each host gets its OWN Basic header.
    assert.eq_str(h, clientlib.basic_auth_for(m, "http://a.example.com/f.zsync"),
        "Basic Ym9iOnNlY3JldA==", "a.example.com -> bob:secret")
    assert.eq_str(h, clientlib.basic_auth_for(m, "https://b.example.com:443/g"),
        "Basic YWxpY2U6cHcxMjM=", "b.example.com -> alice:pw123 (port ignored)")

    // A host with NO entry gets NO auth (not some other host's cred).
    assert.eq_str(h, clientlib.basic_auth_for(m, "http://c.example.com/x"), "", "unmatched host -> no auth")
    // A local path (no host) gets no auth.
    assert.eq_str(h, clientlib.basic_auth_for(m, "/local/f.zsync"), "", "local path -> no auth")
    // Empty map -> no auth.
    empty = clientlib.auth_map_new()
    assert.eq_str(h, clientlib.basic_auth_for(empty, "http://a.example.com/x"), "", "empty map -> no auth")

    // --- output filename resolution (least-surprise + anti-traversal) ---
    q = 1  // quiet: suppress rejection notices in the test

    // base_name: the anti-traversal strip (the security-critical part).
    assert.eq_str(h, clientlib.base_name("../../etc/passwd"), "passwd", "base: unix traversal stripped")
    assert.eq_str(h, clientlib.base_name("..\\..\\windows\\evil"), "evil", "base: windows traversal stripped")
    assert.eq_str(h, clientlib.base_name("/abs/path/file.iso"), "file.iso", "base: absolute path stripped")
    assert.eq_str(h, clientlib.base_name("plain.iso"), "plain.iso", "base: no path unchanged")

    // A matching prefix accepts the (stripped) remote name.
    assert.eq_str(h, clientlib.resolve_output_name("debian-15.0.iso", "https://x.org/debian-15.0.iso.zsync", q),
        "debian-15.0.iso", "resolve: matching prefix accepted")

    // A remote name that tries to escape is stripped THEN prefix-checked;
    // "passwd" doesn't share the "debian" prefix -> rejected, fall back to
    // the source-derived name.
    assert.eq_str(h, clientlib.resolve_output_name("../../etc/passwd", "https://x.org/debian-15.0.iso.zsync", q),
        "debian-15.0.iso", "resolve: traversal rejected, source name used")

    // A surprising-but-harmless name (no shared prefix) is rejected too.
    assert.eq_str(h, clientlib.resolve_output_name("mbox", "https://x.org/foo.iso.zsync", q),
        "foo.iso", "resolve: surprising name rejected")

    // Even a traversal that DID share the prefix is still path-stripped.
    assert.eq_str(h, clientlib.resolve_output_name("../foo.iso", "https://x.org/foo.iso.zsync", q),
        "foo.iso", "resolve: prefixed traversal still stripped")

    // Empty remote name -> source-derived fallback.
    assert.eq_str(h, clientlib.resolve_output_name("", "https://x.org/thing.zsync", q),
        "thing", "resolve: empty remote -> source base")

    // Local .zsync source works the same way.
    assert.eq_str(h, clientlib.resolve_output_name("archive.tar", "/home/u/archive.tar.zsync", q),
        "archive.tar", "resolve: local source, matching prefix")

    // --- check_supplied_filename (-k guard) ---
    // No -k given -> OK.
    assert.eq_str(h, clientlib.check_supplied_filename(""), "", "ksup: empty -> ok")
    // Non-existent path -> OK (fresh file).
    assert.eq_str(h, clientlib.check_supplied_filename("/tmp/zsync_ksup_absent.zzz"), "",
        "ksup: missing file -> ok")
    // Existing path named .zsync -> OK regardless of content.
    zpath = "/tmp/zsync_ksup_named.zsync"
    _w = fs.write_binary(zpath, string.bytes("not really a control file"))
    assert.eq_str(h, clientlib.check_supplied_filename(zpath), "", "ksup: .zsync name -> ok")
    // Existing non-.zsync file that IS a control file (starts "zsync:") -> OK.
    okpath = "/tmp/zsync_ksup_ctl.keep"
    _w = fs.write_binary(okpath, string.bytes("zsync: 0.7.1\nFilename: x\n"))
    assert.eq_str(h, clientlib.check_supplied_filename(okpath), "", "ksup: valid control body -> ok")
    // Existing non-.zsync file that is NOT a control file -> REFUSE.
    badpath = "/tmp/zsync_ksup_data.txt"
    _w = fs.write_binary(badpath, string.bytes("important user data, do not clobber\n"))
    kres = clientlib.check_supplied_filename(badpath)
    assert.ok(h, string_equals(kres, "") == 0, "ksup: non-control file -> refused (non-empty err)")

    // --- progress line formatting ---
    // 50% of a 2000-byte target in 1000ms -> 1000 bytes, 1 KB/s, 50.0%.
    assert.eq_str(h, clientlib.progress_line(1000, 2000, 1000),
        "\r1.0s 1 KB/s 50.0% of target obtained   ", "progress: 50% mid-download")
    // Complete: 100.0%.
    assert.eq_str(h, clientlib.progress_line(2000, 2000, 500),
        "\r0.5s 4 KB/s 100.0% of target obtained   ", "progress: 100% complete")
    // Guard against divide-by-zero (total 0, elapsed 0).
    assert.eq_str(h, clientlib.progress_line(0, 0, 0),
        "\r0.0s 0 KB/s 0.0% of target obtained   ", "progress: zero guards")
    // one-decimal helpers.
    assert.eq_str(h, clientlib.one_dp(3450), "3.4", "one_dp: 3450ms -> 3.4s")
    assert.eq_str(h, clientlib.one_dp_pct(427), "42.7", "one_dp_pct: 427 -> 42.7")

    assert.report(h)
}
