//
// Port of the download core of cmd/zsync/main.go — the HTTP-client half.
// Fetches the .zsync control file and the missing byte ranges over HTTP
// (using std.http.client v2 Range requests), driving the download State.

import std.string (*)
import std.map (*)
import std.fs
import std.http.client
import std.encoding
import zsync.control
import zsync.download
import rcksum.fileio


// Connection options applied to every request, threaded from the CLI.
//   insecure:   1 = skip TLS peer/hostname verification (--no-check-certificate)
//   proxy_mode: 0 = direct, 1 = follow $HTTP_PROXY etc, 2 = explicit proxy_url
struct NetOpts {
    insecure: int
    proxy_mode: int
    proxy_url: string
}

// Default: verify TLS, honour no proxy (direct). Safe baseline.
net_opts_default() -> ptr {
    o = heap.new(NetOpts)
    o.insecure = 0
    o.proxy_mode = 0
    o.proxy_url = ""
    return o
}

net_opts_set_insecure(o: ptr, on: int) {
    s = o as *NetOpts
    s.insecure = on
}

// mode: 1 = use environment proxy, 2 = explicit url (url ignored for mode 1).
net_opts_set_proxy(o: ptr, mode: int, url: string) {
    s = o as *NetOpts
    s.proxy_mode = mode
    s.proxy_url = str_dup(url)
}

// Apply the connection options to a freshly-built request, right after
// client.request(...). Central place so all three request builders stay
// in sync.
apply_net_opts(req: ptr, o: ptr) {
    if o == null {
        return
    }
    s = o as *NetOpts
    if s.insecure == 1 {
        client.set_insecure(req, 1)
    }
    if s.proxy_mode == 1 {
        client.use_env_proxy(req, 1)
    } else if s.proxy_mode == 2 {
        client.use_http_proxy(req, s.proxy_url)
    }
    // mode 0 (direct) is the client default — nothing to do.
}

// Build an HTTP Basic "Authorization" header value from "user:pass",
// or "" if creds is "". Returns e.g. "Basic dXNlcjpwYXNz".
basic_auth(creds: string) -> string {
    if string_equals(creds, "") == 1 {
        return ""
    }
    enc = encoding.base64_encode_padded(creds, string_length(creds))
    return string_concat("Basic ", enc)
}

// --- Per-host auth map (-A host=user:pass, repeatable) -----------------
// Mirrors the Go original's authMap: credentials are keyed by hostname
// and applied only to requests to that host. Stored as host -> "user:pass"
// (the Basic header is built per request in basic_auth_for).

auth_map_new() -> ptr {
    return map_new()
}

// Add one "-A host=user:pass" entry. Silently ignores a malformed value
// with no '=' or no ':' (Go errored; a warning is enough here — the
// caller checks the return: 1 on success, 0 on malformed).
auth_map_add(m: ptr, spec: string) -> int {
    eq = string_index_of(spec, "=")
    if eq < 0 {
        return 0
    }
    host = string_substring(spec, 0, eq)
    pair = string_substring(spec, eq + 1, string_length(spec))
    if string_index_of(pair, ":") < 0 {
        return 0
    }
    if string_equals(host, "") == 1 {
        return 0
    }
    map_put_string_owned(m, host, str_dup(pair))
    return 1
}

// The Authorization header to use for `url`, or "" if no -A entry matches
// the URL's host. Matches Go's `if auth, ok := auths[u.Hostname()]`.
basic_auth_for(m: ptr, url: string) -> string {
    if m == null {
        return ""
    }
    host = host_of(url)
    if string_equals(host, "") == 1 {
        return ""
    }
    if map_has(m, host) == 0 {
        return ""
    }
    creds = fileio.buf_as_string(map_get_raw(m, host))
    return basic_auth(creds)
}

// Extract the hostname (no port) from an http(s) URL, matching Go's
// url.Hostname(). Returns "" for a non-URL (local path) or if unparseable.
host_of(url: string) -> string {
    rest = ""
    if string_starts_with(url, "http://") == 1 {
        rest = string_substring(url, 7, string_length(url))
    } else if string_starts_with(url, "https://") == 1 {
        rest = string_substring(url, 8, string_length(url))
    } else {
        return ""
    }
    // host[:port] ends at the first '/', '?' or '#'.
    end = string_length(rest)
    slash = string_index_of(rest, "/")
    if slash >= 0 && slash < end { end = slash }
    q = string_index_of(rest, "?")
    if q >= 0 && q < end { end = q }
    hh = string_index_of(rest, "#")
    if hh >= 0 && hh < end { end = hh }
    hostport = string_substring(rest, 0, end)
    // strip ":port"
    colon = string_index_of(hostport, ":")
    if colon >= 0 {
        return string_substring(hostport, 0, colon)
    }
    return hostport
}

// Owned copy of a string (so a map/list can outlive the arg buffer).
str_dup(s: string) -> string {
    return string_concat(s, "")
}

// --- Output-filename resolution (least-surprise + anti-traversal) ------
// Mirrors Go's getFilename: a server-controlled Filename: header is NEVER
// trusted verbatim.

// The final path component of `s` — everything after the last '/' or '\'.
// This is the anti-traversal strip: a remote "../../etc/passwd" becomes
// "passwd". Mirrors Go's filepath.Base for the security-relevant case.
base_name(s: string) -> string {
    n = string_length(s)
    last = 0 - 1
    i = 0
    while i < n {
        c = string_char_at(s, i) & 0xff
        if c == 47 || c == 92 {   // '/' or '\'
            last = i
        }
        i = i + 1
    }
    return string_substring(s, last + 1, n)
}

// The source's basename with a trailing ".zsync" removed — a good guess
// at the target filename, and the string whose prefix we least-surprise
// against.
source_base(source: string) -> string {
    b = base_name(source)
    if string_ends_with(b, ".zsync") == 1 {
        return string_substring(b, 0, string_length(b) - 6)
    }
    return b
}

// Leading run of letters/digits of the source basename. Go rejects a
// remote Filename: that doesn't start with this prefix (least surprise:
// `foo.iso.zsync` must not yield `mbox`).
source_prefix(source: string) -> string {
    nb = source_base(source)
    n = string_length(nb)
    i = 0
    while i < n {
        c = string_char_at(nb, i) & 0xff
        is_alnum = 0
        if c >= 48 && c <= 57 { is_alnum = 1 }        // 0-9
        if c >= 65 && c <= 90 { is_alnum = 1 }        // A-Z
        if c >= 97 && c <= 122 { is_alnum = 1 }       // a-z
        if is_alnum == 0 {
            return string_substring(nb, 0, i)
        }
        i = i + 1
    }
    return nb
}

// Decide the output filename when the user gave no -o, matching Go's
// getFilename. Never trusts the remote name verbatim. `quiet` suppresses
// the rejection notice.
resolve_output_name(remote: string, source: string, quiet: int) -> string {
    if string_equals(remote, "") == 0 {
        // 1. strip any path the remote tried to sneak in (anti-traversal)
        name = base_name(remote)
        // 2. accept only if it shares the source's alphanumeric prefix
        prefix = source_prefix(source)
        if string_equals(prefix, "") == 0 {
            if string_starts_with(name, prefix) == 1 {
                return name
            }
            if quiet == 0 {
                println("rejected filename '${name}' from control file: prefix '${prefix}' differs")
            }
        } else {
            // no usable source prefix — the stripped name is still safe
            return name
        }
    }
    // 3. fall back to the source-derived name, then a fixed default
    sb = source_base(source)
    if string_equals(sb, "") == 0 {
        return sb
    }
    return "zsync-download"
}

// Guard the -k keep path before we might overwrite it: refuse to clobber
// an existing file that is NOT a .zsync control file (a fat-fingered
// `-k important.txt` shouldn't destroy your data). Mirrors Go's
// checkSuppliedFilename. Returns "" if it is safe to write `path`, else
// an error string.
check_supplied_filename(path: string) -> string {
    if string_equals(path, "") == 1 {
        return ""                          // no -k given
    }
    if fs.exists(path) == 0 {
        return ""                          // new file — fine
    }
    if string_ends_with(path, ".zsync") == 1 {
        return ""                          // named like a control file — assume intended
    }
    // Existing, non-.zsync: only OK if its first bytes are "zsync:".
    data, n, e = fs.read_binary(path)
    if e != "" {
        return concat3("failed to verify that ", path, " is a zsync control file")
    }
    if has_prefix_bytes(data, n, "zsync:") == 0 {
        return concat3("refusing to overwrite ", path,
            " with a zsync control file — did you use -k on the wrong file?")
    }
    return ""
}

// Binary-safe "does buffer[0..] start with `pfx`?" — string_starts_with
// is strlen-based and would misbehave on a binary first byte.
has_prefix_bytes(data: string, n: int, pfx: string) -> int {
    pn = string_length(pfx)
    if n < pn {
        return 0
    }
    i = 0
    while i < pn {
        if (string_char_at_n(data, n, i) & 0xff) != (string_char_at_n(pfx, pn, i) & 0xff) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Fetch a URL's full body, optionally with an Authorization header and
// an If-Modified-Since value. Returns (body, length, status, last_modified,
// err) — status is exposed so callers can detect 304 Not Modified, and
// last_modified (may be "") lets a -k caller stamp its cached copy so the
// next run sends an accurate If-Modified-Since.
http_get_auth(url: string, auth: string, ims: string, opts: ptr) -> (string, int, int, string, string) {
    req = client.request("GET", url)
    apply_net_opts(req, opts)
    client.set_header(req, "User-Agent", "zsync-aether/0.7.1")
    if string_equals(auth, "") == 0 {
        client.set_header(req, "Authorization", auth)
    }
    if string_equals(ims, "") == 0 {
        client.set_header(req, "If-Modified-Since", ims)
    }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        return "", 0, 0, "", err
    }
    status = client.response_status(resp)
    if status == 304 {
        client.response_free(resp)
        return "", 0, 304, "", ""
    }
    if status != 200 {
        client.response_free(resp)
        return "", 0, status, "", concat3("http status ", int_str(status), "")
    }
    lastmod = str_dup(client.response_header(resp, "Last-Modified"))
    n = client.response_body_length(resp)
    body = client.response_body(resp)
    owned = copy_bytes(body, n)
    client.response_free(resp)
    return owned, n, 200, lastmod, ""
}

// Fetch a URL's full body (no auth, direct/verified). Returns (body, length, err).
http_get(url: string) -> (string, int, string) {
    body, n, status, lastmod, err = http_get_auth(url, "", "", null)
    return body, n, err
}

// Fetch a byte range [start, fin] of a URL via a Range request, with
// optional auth. Expects 206 Partial Content. Returns (body, length, err).
http_get_range_auth(url: string, start: int, fin: int, auth: string, opts: ptr) -> (string, int, string) {
    req = client.request("GET", url)
    apply_net_opts(req, opts)
    client.set_header(req, "User-Agent", "zsync-aether/0.7.1")
    client.set_header(req, "Range", range_header(start, fin))
    if string_equals(auth, "") == 0 {
        client.set_header(req, "Authorization", auth)
    }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        return "", 0, err
    }
    status = client.response_status(resp)
    if status != 206 {
        client.response_free(resp)
        return "", 0, concat3("expected 206, got ", int_str(status), "")
    }
    n = client.response_body_length(resp)
    body = client.response_body(resp)
    owned = copy_bytes(body, n)
    client.response_free(resp)
    return owned, n, ""
}

http_get_range(url: string, start: int, fin: int) -> (string, int, string) {
    return http_get_range_auth(url, start, fin, "", null)
}

// Like http_get_range_auth but returns the body as a RAW malloc'd ptr
// (no heap-string-tracker header), so it can be carried across an actor
// mailbox boundary and retyped with fileio.buf_as_string on the far side
// without the tracker recycling it. Returns (buf, len, err); buf is null
// on error. Caller owns buf (fileio.buf_free when done).
http_get_range_raw(url: string, start: int, fin: int, auth: string, opts: ptr) -> (ptr, int, string) {
    req = client.request("GET", url)
    apply_net_opts(req, opts)
    client.set_header(req, "User-Agent", "zsync-aether/0.7.1")
    client.set_header(req, "Range", range_header(start, fin))
    if string_equals(auth, "") == 0 {
        client.set_header(req, "Authorization", auth)
    }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        return null, 0, err
    }
    status = client.response_status(resp)
    if status != 206 {
        client.response_free(resp)
        return null, 0, concat3("expected 206, got ", int_str(status), "")
    }
    n = client.response_body_length(resp)
    body = client.response_body(resp)
    // Copy into a raw buffer that outlives response_free and carries no
    // tracker header (survives the actor message copy intact).
    b = fileio.buf_alloc(n)
    i = 0
    while i < n {
        fileio.buf_set(b, i, string_char_at_n(body, n, i) & 0xff)
        i = i + 1
    }
    client.response_free(resp)
    return b, n, ""
}

// "bytes=START-FIN"
range_header(start: int, fin: int) -> string {
    return concat3("bytes=", int_str(start), concat3("-", int_str(fin), ""))
}

// Copy n bytes of a (possibly borrowed) body into an owned buffer so it
// survives response_free. Binary-safe.
copy_bytes(body: string, n: int) -> string {
    b = fileio.buf_alloc(n)
    i = 0
    while i < n {
        fileio.buf_set(b, i, string_char_at_n(body, n, i) & 0xff)
        i = i + 1
    }
    return fileio.buf_to_str(b, n)
}

// Read the control file from a local path if it exists, else HTTP GET.
fetch_control(source: string) -> (string, int, string) {
    if fs.exists(source) == 1 {
        data, n, e = fs.read_binary(source)
        return data, n, e
    }
    return http_get(source)
}

// Fetch all the missing byte ranges of the download from `url` (with
// optional auth) and feed them into the State. Returns "" on success,
// error string otherwise.
fetch_remaining(st: ptr, url: string, auth: string) -> string {
    while download.status(st) < 2 {
        needed = download.needed_byte_ranges(st)
        nn = download.br_count(needed)
        if nn == 0 {
            return ""
        }
        i = 0
        while i < nn {
            rstart = download.br_at_start(needed, i)
            rfin = download.br_at_fin(needed, i)
            chunk, clen, e = http_get_range_auth(url, rstart, rfin, auth)
            if e != "" {
                return e
            }
            download.submit_target_data(st, rstart, chunk, clen)
            i = i + 1
        }
    }
    return ""
}

concat3(a: string, b: string, c: string) -> string {
    return string_concat(string_concat(a, b), c)
}

int_str(v: int) -> string {
    return string_from_int(v)
}

// --- Live progress line -----------------------------------------------
// "\r<elapsed>s <rate> <pct>% of target obtained" — printed to stderr as
// ranges arrive (mirrors Go's meter). Integer math throughout (float->
// string is awkward in Aether): rate in KB/s, elapsed and pct to 1 dp.
progress_line(got: int, total: int, elapsed_ms: int) -> string {
    pct10 = 0
    if total > 0 {
        pct10 = (got * 1000) / total    // percent * 10
    }
    kbps = 0
    if elapsed_ms > 0 {
        kbps = got / elapsed_ms          // bytes/ms == KB/s
    }
    return concat3(
        concat3("\r", one_dp(elapsed_ms), "s "),
        concat3(int_str(kbps), " KB/s ", one_dp_pct(pct10)),
        "% of target obtained   ")
}

// Render tenths-of-a-percent (e.g. 427 -> "42.7").
one_dp_pct(x10: int) -> string {
    return concat3(int_str(x10 / 10), ".", int_str(x10 - (x10 / 10) * 10))
}

// Render milliseconds as seconds with one decimal (e.g. 3450 -> "3.4").
one_dp(ms: int) -> string {
    tenths = ms / 100
    return concat3(int_str(tenths / 10), ".", int_str(tenths - (tenths / 10) * 10))
}
