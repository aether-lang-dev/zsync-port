// SPDX-License-Identifier: Artistic-2.0
//
// zsync client entry point. Downloads a file described by a .zsync
// control file, reusing local data (seed files) and fetching only the
// missing byte ranges over HTTP. Thin CLI over cmd.clientlib.
//
// Usage:
//   zsync [-o output] [-i seedfile]... [-A host=user:pass] [-k keep.zsync]
//         [-q] [-v] [-V] [--no-check-certificate] <url-or-path-to-.zsync>

import std.string (
    string_concat, string_length, string_char_at, string_equals,
    string_starts_with, string_substring
)
import std.list (
    list_new, list_add_raw, list_get_raw, list_size
)
import std.os (*)
import std.io
import std.fs
import std.http.client
import zsync.control
import zsync.download
import cmd.clientlib
import rcksum.fileio

VERSION() -> string {
    return "0.7.1"
}

// Max byte-ranges fetched concurrently (matches the Go original's
// errgroup SetLimit(3)).
const FETCH_CONCURRENCY = 3

// ---------------------------------------------------------------------
// Parallel range fetching (up to FETCH_CONCURRENCY ranges in flight).
//
// The Go original fetched up to 3 ranges concurrently (errgroup +
// SetLimit(3)); this mirrors that with the actor model. The HTTP fetch —
// the blocking, parallelisable part — runs in Fetcher actors; the submit
// back into the single-threaded download State stays serialised because
// it happens only inside the Coordinator's one mailbox. rcksum stays
// single-threaded exactly as its header comment promises.
//
// std.http.client is safe to call from multiple actors at once (per-
// request sockets, getaddrinfo-based thread-safe DNS). On the default
// multicore build each Fetcher's blocking GET runs on its own scheduler
// thread, so the fetches genuinely overlap.
//
// (Actors must be declared in the module that owns main() — the compiler
// only emits spawn_<Actor> for actors in the main compilation unit — so
// this lives here rather than in cmd.clientlib.)
// ---------------------------------------------------------------------

// A range to fetch, sent to a free Fetcher. `coord` is the Coordinator
// ref the Fetcher reports back to; `net` is the shared connection options.
message FetchJob { url: string, start: int, fin: int, auth: string, net: ptr, coord: ptr }

// A completed (or failed) fetch, Fetcher -> Coordinator. `worker` is the
// Fetcher's own ref so the Coordinator can hand it the next range.
message FetchDone { data: ptr, len: int, offset: int, err: string, worker: ptr }

// Kick off the initial wave of dispatches.
message FetchStart {}

actor Fetcher {
    receive {
        FetchJob(url, start, fin, auth, net, coord) -> {
            buf, n, e = clientlib.http_get_range_raw(url, start, fin, auth, net)
            coord ! FetchDone { data: buf, len: n, offset: start, err: e, worker: self }
        }
    }
}

// Owns the download State and the needed-range list. Serialises every
// submit through its single mailbox. Keeps at most one job per Fetcher in
// flight, dispatching the next range whenever a Fetcher reports back.
// Written only by the coordinator and read after wait_for_idle().
// See asks/actor-string-state-atomic-load.md for the compiler limitation.
struct FetchResult { err: string }

actor FetchCoordinator {
    state st = null
    state ranges = null
    state nn = 0
    state cursor = 0
    state url = ""
    state auth = ""
    state result = null
    state quiet = 1
    state start_ms = 0
    state net = null

    receive {
        FetchStart() -> {
            // Dispatch the first wave, one range per Fetcher.
            w = 0
            while w < FETCH_CONCURRENCY {
                if cursor < nn {
                    f = spawn(Fetcher())
                    rstart = download.br_at_start(ranges, cursor)
                    rfin = download.br_at_fin(ranges, cursor)
                    cursor = cursor + 1
                    f ! FetchJob { url: url, start: rstart, fin: rfin, auth: auth, net: net, coord: self }
                }
                w = w + 1
            }
        }
        FetchDone(data, len, offset, err, worker) -> {
            outcome = result as *FetchResult
            // Termination is driven by wait_for_idle (a message counts as
            // in-flight until its handler returns, and each Fetcher's GET
            // runs synchronously inside its handler), so no pending counter
            // is needed — dropping dispatch on error lets in-flight drain.
            if err != "" {
                if string_equals(outcome.err, "") == 1 {
                    // The message owns err; keep a separate owned copy.
                    outcome.err = string_concat("", err)
                }
            } else {
                // Serialised submit into the single-threaded State.
                download.submit_target_data(st, offset, fileio.buf_to_str(data, len), len)
                fileio.buf_free(data)
                // Live progress line (stderr, \r-overwritten) as ranges land.
                if quiet == 0 {
                    got, total = download.progress(st)
                    elapsed = now_monotonic_ms() - start_ms
                    io.stderr_write(clientlib.progress_line(got, total, elapsed))
                }
            }
            // On success with work left, re-use this worker for the next
            // range. On error, stop dispatching and let in-flight drain.
            if string_equals(outcome.err, "") == 1 {
                if cursor < nn {
                    rstart = download.br_at_start(ranges, cursor)
                    rfin = download.br_at_fin(ranges, cursor)
                    cursor = cursor + 1
                    worker ! FetchJob { url: url, start: rstart, fin: rfin, auth: auth, net: net, coord: self }
                }
            }
        }
    }
}

// Fetch all missing byte ranges from `url`, up to FETCH_CONCURRENCY at a
// time. Returns "" on success, an error string otherwise. When quiet==0 a
// live progress line is printed to stderr as ranges arrive.
fetch_remaining_parallel(st: @keep ptr, url: string, auth: string, quiet: int, net: @keep ptr) -> string {
    needed = download.needed_byte_ranges(st)
    nn = download.br_count(needed)
    if nn == 0 {
        return ""
    }

    outcome = heap.new(FetchResult)
    outcome.err = ""
    coord = spawn(FetchCoordinator())
    coord.result = outcome
    coord.st = st
    coord.ranges = needed
    coord.nn = nn
    coord.url = url
    coord.auth = auth
    coord.quiet = quiet
    coord.start_ms = now_monotonic_ms()
    coord.net = net
    coord ! FetchStart {}
    wait_for_idle()

    // Terminate the \r-updated progress line with a newline.
    if quiet == 0 {
        io.stderr_write("\n")
    }
    return outcome.err
}

main() {
    argc = aether_args_count()
    out = ""
    seeds = list_new()
    auths = clientlib.auth_map_new()   // host -> "user:pass" from -A (repeatable)
    keep = ""            // -k path
    quiet = 0
    verbose = 0
    source = ""
    referer = ""         // -u base URL for resolving relative URLs in a local .zsync
    insecure = 0         // --no-check-certificate
    proxy_mode = 1       // default: follow $HTTP_PROXY (Go-compatible)
    proxy_url = ""       // --proxy URL (explicit)

    i = 1
    while i < argc {
        a = aether_args_get(i)
        if string_equals(a, "-o") == 1 {
            i = i + 1
            out = aether_args_get(i)
        } else if string_equals(a, "-i") == 1 {
            i = i + 1
            list_add_raw(seeds, str_owned(aether_args_get(i)))
        } else if string_equals(a, "-A") == 1 {
            i = i + 1
            spec = aether_args_get(i)
            if clientlib.auth_map_add(auths, spec) == 0 {
                println("warning: ignoring malformed -A '${spec}' (want host=user:pass)")
            }
        } else if string_equals(a, "-k") == 1 {
            i = i + 1
            keep = aether_args_get(i)
        } else if string_equals(a, "-u") == 1 {
            i = i + 1
            referer = aether_args_get(i)
        } else if string_equals(a, "-q") == 1 {
            quiet = 1
        } else if string_equals(a, "-v") == 1 {
            verbose = 1
        } else if string_equals(a, "-V") == 1 {
            println("zsync v${VERSION()}")
            exit(0)
        } else if string_equals(a, "--no-check-certificate") == 1 {
            // Skip TLS peer/hostname verification (self-signed hosts).
            // Applied per-connection via client.set_insecure (aether#1012).
            insecure = 1
        } else if string_equals(a, "--proxy") == 1 {
            i = i + 1
            proxy_url = aether_args_get(i)
            proxy_mode = 2       // explicit proxy, env ignored
        } else if string_equals(a, "--no-proxy") == 1 {
            proxy_mode = 0       // force direct, ignore $HTTP_PROXY
        } else {
            source = a
        }
        i = i + 1
    }

    if string_equals(source, "") == 1 {
        println("usage: zsync [-o out] [-i seed]... [-A host=user:pass] [-k keep] [-u url]")
        println("             [--no-check-certificate] [--proxy URL] [--no-proxy]")
        println("             [-q] [-v] [-V] <.zsync>")
        exit(3)
    }

    // Connection options applied to every request (TLS-verify skip, proxy).
    net = clientlib.net_opts_default()
    clientlib.net_opts_set_insecure(net, insecure)
    clientlib.net_opts_set_proxy(net, proxy_mode, proxy_url)

    // Guard -k: refuse to overwrite a non-.zsync file with the control
    // copy (catches `-k` aimed at the wrong file) before any write.
    kerr = clientlib.check_supplied_filename(keep)
    if string_equals(kerr, "") == 0 {
        println(kerr)
        exit(3)
    }

    // 1. fetch + parse the control file (with -k If-Modified-Since reuse).
    //    The control file's auth follows the source URL's host.
    ctl_auth = clientlib.basic_auth_for(auths, source)
    cbytes, clen, cerr = get_control(source, keep, ctl_auth, quiet, net)
    if cerr != "" {
        println("failed to fetch control file: ${cerr}")
        exit(3)
    }
    ctl = control.parse(cbytes, clen)
    if control.ctl_ok(ctl) == 0 {
        println("failed to parse control file: ${control.ctl_err(ctl)}")
        exit(3)
    }

    // 2. output filename. With no -o, derive it from the control file's
    //    Filename: header, but NEVER trust it verbatim — strip any path
    //    component (anti-traversal) and apply the least-surprise prefix
    //    check against the source name. See resolve_output_name.
    if string_equals(out, "") == 1 {
        out = clientlib.resolve_output_name(control.ctl_filename(ctl), source, quiet)
    }

    fd = fileio.open_rw(out)
    if fd < 0 {
        println("cannot open output ${out}")
        exit(1)
    }
    st = download.new_state(ctl, fd)

    // 3. seed from the existing output/temp first, then the -i files.
    //    (The existing target is the most useful seed if a prior run
    //    left one.)
    feed_seed_if_exists(st, out, quiet)
    ns = list_size(seeds)
    si = 0
    while si < ns {
        sf = fileio.buf_as_string(list_get_raw(seeds, si))
        feed_seed_if_exists(st, sf, quiet)
        si = si + 1
    }

    if download.status(st) == 0 {
        if quiet == 0 {
            println("No relevant local data — downloading the whole file.")
        }
    }

    // 4. fetch the missing ranges, trying each URL until one succeeds.
    //    Relative URLs in the .zsync resolve against `-u` if given, else
    //    the source. -u is what makes a *local* .zsync with relative URLs
    //    usable (the source is then a file path, not a base URL).
    base = source
    if string_equals(referer, "") == 0 {
        base = referer
    }
    ferr = fetch_from_urls(st, ctl, base, auths, quiet, net)
    if ferr != "" {
        println("download failed: ${ferr}")
        exit(3)
    }

    // 5. finalize + verify
    cerr2 = download.complete(st)
    fileio.close_fd(fd)
    if cerr2 != "" {
        println("verification failed: ${cerr2}")
        exit(2)
    }
    // Restore the file's mtime from the .zsync MTime header (matches Go's
    // os.Chtimes). Best-effort: a parse/utimes failure warns, never fatal.
    mtime_hdr = control.ctl_mtime(ctl)
    if string_equals(mtime_hdr, "") == 0 {
        epoch = fileio.parse_rfc1123(mtime_hdr)
        if epoch >= 0 {
            if fileio.set_mtime(out, epoch) != 0 {
                if quiet == 0 {
                    println("warning: failed to set mtime on ${out}")
                }
            }
        } else {
            if quiet == 0 {
                println("warning: could not parse MTime header '${mtime_hdr}'")
            }
        }
    }

    if quiet == 0 {
        println("verifying download...checksum matches OK")
        got, total = download.progress(st)
        println("download complete: ${out}")
    }
    if verbose == 1 {
        s = download.stats_line(st)
        println(s)
    }
}

// Fetch the control file. If -k is set and a local copy exists, send
// If-Modified-Since and reuse the local copy on 304. On a fresh fetch
// with -k set, save the downloaded control file to the keep path.
get_control(source: string, keep: string, auth: string, quiet: int, net: ptr) -> (string, int, string) {
    // local .zsync path takes precedence
    if fs.exists(source) == 1 {
        return fs.read_binary(source)
    }
    ims = ""
    if string_equals(keep, "") == 0 {
        if fs.exists(keep) == 1 {
            epoch, me = fs.mtime(keep)
            if me == "" {
                ims = fileio.rfc1123z(epoch)
            }
        }
    }
    body, n, status, lastmod, e = clientlib.http_get_auth(source, auth, ims, net)
    if status == 304 {
        if quiet == 0 {
            println("control file not modified — using local copy")
        }
        return fs.read_binary(keep)
    }
    if e != "" {
        return "", 0, e
    }
    if string_equals(keep, "") == 0 {
        _w = fs.write_binary(keep, fileio.view(body, n))
        // Stamp the saved copy's mtime from the server's Last-Modified so
        // a rerun sends an accurate If-Modified-Since (matches Go). If the
        // server sent none, the file keeps "now" — still yields a correct
        // 304 for an unchanged file, just less precise.
        if string_equals(lastmod, "") == 0 {
            epoch2 = fileio.parse_rfc1123(lastmod)
            if epoch2 >= 0 {
                fileio.set_mtime(keep, epoch2)
            }
        }
    }
    return body, n, ""
}

// Try each URL in the control file (relative URLs resolved against
// `base` — the -u value or the source) until the download completes.
// Mirrors the Go failover, minus the randomisation (deterministic order
// is friendlier to test).
fetch_from_urls(st: @keep ptr, ctl: ptr, base: string, auths: ptr, quiet: int, net: @keep ptr) -> string {
    urls = control.ctl_urls(ctl)
    if urls == null {
        return "no download URLs known"
    }
    n = list_size(urls)
    if n == 0 {
        return "no download URLs known"
    }
    last_err = "no download URLs known"
    i = 0
    while i < n {
        if download.status(st) >= 2 {
            return ""
        }
        u = resolve(fileio.buf_as_string(list_get_raw(urls, i)), base)
        if quiet == 0 {
            println("downloading new blocks from ${u}")
        }
        u_auth = clientlib.basic_auth_for(auths, u)
        e = fetch_remaining_parallel(st, u, u_auth, quiet, net)
        if e == "" {
            return ""
        }
        last_err = e
        if quiet == 0 {
            println("failed from ${u}: ${e}")
        }
        i = i + 1
    }
    if download.status(st) >= 2 {
        return ""
    }
    return last_err
}

feed_seed_if_exists(st: ptr, path: string, quiet: int) {
    if fs.exists(path) == 0 {
        return
    }
    data, n, e = fs.read_binary(path)
    if e != "" {
        return
    }
    if quiet == 0 {
        println("reading seed file ${path}")
    }
    download.submit_source(st, data, n)
}

// Resolve a (possibly relative) URL from the control file against the
// source URL's directory.
resolve(u: string, source: string) -> string {
    if is_abs(u) == 1 {
        return u
    }
    last = last_slash(source)
    if last < 0 {
        return u
    }
    return string_concat(string_substring(source, 0, last + 1), u)
}

is_abs(u: string) -> int {
    if string_starts_with(u, "http://") == 1 {
        return 1
    }
    if string_starts_with(u, "https://") == 1 {
        return 1
    }
    return 0
}

last_slash(s: string) -> int {
    n = string_length(s)
    last = 0 - 1
    i = 0
    while i < n {
        if (string_char_at(s, i) & 0xff) == 47 {
            last = i
        }
        i = i + 1
    }
    return last
}


// Copy an argv string so it survives in the seeds list.
str_owned(s: string) -> string {
    return string_concat(s, "")
}
