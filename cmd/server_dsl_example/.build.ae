// aeb build for the closure-DSL server example (config-IS-code surface).
import bldr
import aether
import aether (source, output, extra_source, no_closure_regen)

main() {
    bldr.build() {
        aether.program() {
            source("../server_dsl_example.ae")
            extra_source("../../rcksum/fileio.c")
            no_closure_regen()
            output("server_dsl_example")
        }
        return 0
    }
}
