//
// aeb build for `zsyncmake` (.zsync control-file generator). Links the
// rcksum/fileio.c positional-I/O shim (zsyncmake imports rcksum.fileio).
import bldr
import aether
import aether (source, output, extra_source, no_closure_regen)

main() {
    bldr.build() {
        aether.program() {
            source("../zsyncmake.ae")
            extra_source("../../rcksum/fileio.c")
            no_closure_regen()
            output("zsyncmake")
        }
        return 0
    }
}
