//
// Port of internal/zsync/control_file.go — parse a .zsync control file
// (text headers, blank line, then the binary block-checksum table) into
// an rcksum state plus the metadata the client needs.

import std.string (*)
import std.list (*)
import rcksum.rcksum
import rcksum.checksums
import rcksum.fileio


// Parsed control file: rcksum state + header metadata.
struct Control {
    rs: ptr           // *RcksumState
    filelen: int
    blocks: int
    blocksize: int
    checksum: string  // hex SHA-1 of the whole file ("" if absent)
    checksum_method: string
    filename: string
    mtime: string     // RFC1123Z string, "" if absent
    urls: ptr         // std.list of URL strings
    ok: int           // 1 if parse succeeded
    err: string
}

ctl_rs(c: *Control) -> ptr { return c.rs }
ctl_filelen(c: *Control) -> int { return c.filelen }
ctl_blocks(c: *Control) -> int { return c.blocks }
ctl_blocksize(c: *Control) -> int { return c.blocksize }
ctl_checksum(c: *Control) -> string { return c.checksum }
ctl_filename(c: *Control) -> string { return c.filename }
ctl_mtime(c: *Control) -> string { return c.mtime }
ctl_urls(c: *Control) -> ptr { return c.urls }
ctl_ok(c: *Control) -> int { return c.ok }
ctl_err(c: *Control) -> string { return c.err }

fail(c: *Control, msg: string) -> *Control {
    c.ok = 0
    c.err = msg
    return c
}

// Big-endian decode of `n` bytes at offset `off` in `data`.
be_decode(data: string, data_len: int, off: int, n: int) -> int {
    v = 0
    i = 0
    while i < n {
        v = (v << 8) | (string_char_at_n(data, data_len, off + i) & 0xff)
        i = i + 1
    }
    return v
}

// Is x a power of two (and non-zero)?
is_pow2(x: int) -> int {
    if x == 0 {
        return 0
    }
    if (x & (x - 1)) == 0 {
        return 1
    }
    return 0
}

// Parse a whole .zsync control file given its raw bytes.
parse(data: string, data_len: int) -> *Control {
    c = heap.new(Control)
    c.filelen = 0
    c.blocks = 0
    c.blocksize = 0
    c.checksum = ""
    c.checksum_method = ""
    c.filename = ""
    c.mtime = ""
    c.urls = list_new()
    c.ok = 0
    c.err = ""

    checksum_bytes = 16
    rsum_bytes = 4
    seq_matches = 1

    // --- text header section: scan line by line until a blank line ---
    pos = 0
    header_end = 0
    while pos < data_len {
        // find end of line
        nl = index_byte(data, data_len, pos, 10)   // '\n'
        if nl < 0 {
            return fail(c, "control file: unterminated header")
        }
        line_len = nl - pos
        if line_len == 0 {
            header_end = nl + 1
            pos = data_len   // break
        } else {
            line = substr(data, pos, nl)
            // split on ": "
            sep = find_sep(line)
            if sep < 0 {
                return fail(c, "bad line")
            }
            key = string_substring(line, 0, sep)
            value = string_substring(line, sep + 2, string_length(line))

            if string_equals(key, "zsync") == 1 {
                if string_equals(value, "0.0.4") == 1 {
                    return fail(c, "not compatible with zsync 0.0.4")
                }
            } else if string_equals(key, "Min-Version") == 1 {
                // assume ok
            } else if string_equals(key, "Length") == 1 {
                c.filelen = parse_int(value)
            } else if string_equals(key, "Filename") == 1 {
                c.filename = value
            } else if string_equals(key, "URL") == 1 {
                list_add_raw(c.urls, value)
            } else if string_equals(key, "Blocksize") == 1 {
                c.blocksize = parse_int(value)
                if is_pow2(c.blocksize) == 0 {
                    return fail(c, "nonsensical blocksize")
                }
            } else if string_equals(key, "Hash-Lengths") == 1 {
                sm, rb, cb, ok = parse_hash_lengths(value)
                if ok == 0 {
                    return fail(c, "bad hash lengths")
                }
                seq_matches = sm
                rsum_bytes = rb
                checksum_bytes = cb
                if rsum_bytes < 1 {
                    return fail(c, "nonsensical hash lengths")
                }
                if rsum_bytes > 4 {
                    return fail(c, "nonsensical hash lengths")
                }
                if checksum_bytes < 3 {
                    return fail(c, "nonsensical hash lengths")
                }
                if checksum_bytes > 16 {
                    return fail(c, "nonsensical hash lengths")
                }
                if seq_matches < 1 {
                    return fail(c, "nonsensical hash lengths")
                }
                if seq_matches > 2 {
                    return fail(c, "nonsensical hash lengths")
                }
            } else if string_equals(key, "SHA-1") == 1 {
                if string_length(value) != 40 {
                    return fail(c, "SHA-1 digest wrong length")
                }
                c.checksum = value
                c.checksum_method = "SHA-1"
            } else if string_equals(key, "MTime") == 1 {
                c.mtime = value
            } else if string_equals(key, "Safe") == 1 {
                // tolerated; we accept the headers we know
            } else {
                return fail(c, "unknown header")
            }
            pos = nl + 1
        }
    }

    if c.filelen != 0 {
        if c.blocksize != 0 {
            c.blocks = (c.filelen + c.blocksize - 1) / c.blocksize
        }
    }
    if c.filelen == 0 {
        return fail(c, "not a zsync file")
    }
    if c.blocksize == 0 {
        return fail(c, "not a zsync file")
    }

    rs = rcksum.new(c.blocks, c.blocksize, rsum_bytes, checksum_bytes, seq_matches)
    c.rs = rcksum.state_as_ptr(rs)

    // --- binary checksum table: blocks * (rsum_bytes + checksum_bytes) ---
    bp = header_end
    i = 0
    while i < c.blocks {
        if bp + rsum_bytes + checksum_bytes > data_len {
            return fail(c, "control file truncated in checksum table")
        }
        // rsum: rsum_bytes big-endian, right-aligned into a 4-byte field.
        // The 16-bit A is the high half, B the low half of the 32-bit
        // value (matching Go's binary.Decode into RSum{A,B}).
        rsum_val = be_decode(data, data_len, bp, rsum_bytes)
        a = (rsum_val >> 16) & 0xffff
        b = rsum_val & 0xffff
        bp = bp + rsum_bytes

        // checksum: checksum_bytes of the MD4 prefix; pad to 16 with 0.
        md = pad_md4(data, data_len, bp, checksum_bytes)
        bp = bp + checksum_bytes

        rcksum.add_target_block(rs, i, a, b, md)
        i = i + 1
    }

    c.ok = 1
    return c
}

// Build a 16-byte MD4 buffer = first `n` bytes from src[off..], rest
// zero. Uses the fileio byte buffer (binary-safe; string_concat can't
// build buffers with embedded NULs).
pad_md4(data: string, data_len: int, off: int, n: int) -> string {
    b = fileio.buf_alloc(16)
    i = 0
    while i < 16 {
        if i < n {
            fileio.buf_set(b, i, string_char_at_n(data, data_len, off + i) & 0xff)
        }
        i = i + 1
    }
    // dup16 returns a process-lifetime raw buffer (untracked) so the
    // heap-string tracker can't recycle it under the long-lived
    // HashEntry.md4 field. (buf_to_str's tracked string was reused,
    // cross-linking block checksums with a +2 shift.)
    return fileio.dup16(b)
}

// --- small string helpers ---

substr(s: string, start: int, fin: int) -> string {
    return string_substring(s, start, fin)
}

// find first occurrence of byte `target` in [from, data_len); -1 if none
index_byte(data: string, data_len: int, from: int, target: int) -> int {
    i = from
    while i < data_len {
        if (string_char_at_n(data, data_len, i) & 0xff) == target {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// find ": " in a line, return index of ':' or -1
find_sep(line: string) -> int {
    n = string_length(line)
    i = 0
    while i < n - 1 {
        if (string_char_at(line, i) & 0xff) == 58 {       // ':'
            if (string_char_at(line, i + 1) & 0xff) == 32 {  // ' '
                return i
            }
        }
        i = i + 1
    }
    return 0 - 1
}

parse_int(s: string) -> int {
    ok = string_try_long(s)
    if ok == 0 {
        return 0
    }
    return string_get_long(s)
}

// Parse "seq,rsum,cksum" -> (seq, rsum, cksum, ok)
parse_hash_lengths(value: string) -> (int, int, int, int) {
    parts = string_split(value, ",")
    if string_array_size(parts) != 3 {
        return 0, 0, 0, 0
    }
    p0 = string_array_get(parts, 0)
    p1 = string_array_get(parts, 1)
    p2 = string_array_get(parts, 2)
    sm = parse_int_p(p0)
    rb = parse_int_p(p1)
    cb = parse_int_p(p2)
    return sm, rb, cb, 1
}

// parse_int over a borrowed string-array element (copy first to be
// safe — string_array_get returns a borrowed pointer).
parse_int_p(p: ptr) -> int {
    s = string_concat(fileio.buf_as_string(p), "")
    return parse_int(s)
}


