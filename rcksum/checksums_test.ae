// SPDX-License-Identifier: Artistic-2.0
//
// Parity test for checksums.ae. Reference values generated by running
// the actual Go rcksum code (internal/rcksum) — asserted byte-exact so
// the uint16 wraparound and MD4 truncation reproduce precisely.

import std.string (
    string_concat, string_length, string_substring, string_char_at_n,
    string_from_char
)
import std.cryptography (*)
import rcksum.checksums
import test.assert

// Hex-encode the first n bytes of a binary digest for comparison.
hex_of(digest: string, n: int) -> string {
    out = ""
    digits = "0123456789abcdef"
    i = 0
    while i < n {
        c = string_char_at_n(digest, n, i) & 0xff
        hi = (c >> 4) & 0xf
        lo = c & 0xf
        out = string_concat(out, string_substring(digits, hi, hi + 1))
        out = string_concat(out, string_substring(digits, lo, lo + 1))
        i = i + 1
    }
    return out
}

main() {
    println("=== checksums parity (refs from Go oracle) ===")
    h = assert.new()

    // CalcRsumBlock("The quick brown fox jumps over the lazy dog.")
    // Go: A=4103 B=27561
    s1 = "The quick brown fox jumps over the lazy dog."
    n1 = string_length(s1)
    r1 = checksums.calc_rsum_block(s1, n1, 0, n1)
    assert.eq_int(h, checksums.rsum_a(r1), 4103, "rsum A (fox)")
    assert.eq_int(h, checksums.rsum_b(r1), 27561, "rsum B (fox)")

    // MD4 of the same = 2812c6c7136898c51f6f6739ad08750e
    md1 = checksums.calc_checksum(s1, n1)
    assert.ok(h, string_length(md1) == 16, "md4 not null")
    assert.eq_str(h, hex_of(md1, 16), "2812c6c7136898c51f6f6739ad08750e", "md4 full (fox)")
    // Truncated-to-3 prefix as the .zsync format stores
    assert.eq_str(h, hex_of(md1, 3), "2812c6", "md4 truncated to 3 bytes")

    // 300 bytes of 0xFF — forces uint16 wraparound (300*255 > 65535).
    // Go: A=10964 B=44450
    big = ""
    ff = string_from_char(255)
    i = 0
    while i < 300 {
        big = string_concat(big, ff)
        i = i + 1
    }
    rb = checksums.calc_rsum_block(big, 300, 0, 300)
    assert.eq_int(h, checksums.rsum_a(rb), 10964, "rsum A wraparound (300xFF)")
    assert.eq_int(h, checksums.rsum_b(rb), 44450, "rsum B wraparound (300xFF)")

    // updateRsum roll: CalcRsumBlock("abcd"), then roll out 'a'(97) in
    // 'e'(101) with shift=2. Go: A=398 B=990
    d4 = "abcd"
    r4 = checksums.calc_rsum_block(d4, 4, 0, 4)
    checksums.update_rsum(r4, 97, 101, 2)
    assert.eq_int(h, checksums.rsum_a(r4), 398, "rolled A")
    assert.eq_int(h, checksums.rsum_b(r4), 990, "rolled B")

    // log2
    assert.eq_int(h, checksums.log2(2048), 11, "log2(2048)=11")
    assert.eq_int(h, checksums.log2(1), 0, "log2(1)=0")
    assert.eq_int(h, checksums.log2(0), 0, "log2(0)=0")
    assert.eq_int(h, checksums.log2(4096), 12, "log2(4096)=12")

    assert.report(h)
}
