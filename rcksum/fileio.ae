//
// Aether surface over the positional-I/O C shim (fileio.c).
//
// NOTE: as of Aether 0.218, std.fs has native positional I/O
// (fs.pwrite/pread/ftruncate/fsync, #640 — which this port surfaced).
// We deliberately keep this thin int-fd shim because (a) the rest of the
// port threads an int fd with a `< 0` sentinel through rcksum/download,
// and std's API is ptr-handle based, and (b) the shim also provides the
// mutable byte-buffer + binary-slice helpers std still lacks. The
// positional ops here are a 1:1 match for the std calls and could be
// swapped if the fd model is ever revisited.

import std.string (*)

extern zsync_io_open_rw_trunc(path: string) -> int
extern zsync_io_open_ro(path: string) -> int
extern zsync_io_pwrite(fd: int, buf: string, count: long, offset: long) -> long
extern zsync_io_pread_alloc(fd: int, count: long, offset: long) -> string
extern zsync_io_last_read_len() -> long
extern zsync_io_ftruncate(fd: int, length: long) -> int
extern zsync_io_close(fd: int) -> int
extern zsync_io_fsync(fd: int) -> int

// Open the output file for read+write, creating/truncating. Returns
// the fd (>=0) or -1.
open_rw(path: string) -> int {
    return zsync_io_open_rw_trunc(path)
}

open_ro(path: string) -> int {
    return zsync_io_open_ro(path)
}

// Write `len` bytes of `data` at byte `offset`. Returns bytes written
// or -1. `data` may contain embedded NULs (binary blocks) — the count
// is explicit, so it is binary-safe. int args widen implicitly to the
// shim's long params; the long result narrows back to int (block writes
// are always < 2^31).
write_at(fd: int, data: string, len: int, offset: int) -> int {
    written = zsync_io_pwrite(fd, data, len, offset)
    return written
}

// Read `len` bytes at `offset` into a fresh heap buffer. Returns the
// buffer as a length-aware string and the number of bytes actually
// read (may be < len at EOF), or ("", -1) on error.
read_at(fd: int, len: int, offset: int) -> (string, int) {
    buf = zsync_io_pread_alloc(fd, len, offset)
    n = zsync_io_last_read_len()
    if n < 0 {
        return "", -1
    }
    // Wrap the malloc'd C buffer as a length-aware Aether string so
    // embedded NULs survive (block data is binary).
    s = string_new_with_length(buf, n)
    return s, n
}

truncate_to(fd: int, length: int) -> int {
    return zsync_io_ftruncate(fd, length)
}

close_fd(fd: int) -> int {
    return zsync_io_close(fd)
}

sync_fd(fd: int) -> int {
    return zsync_io_fsync(fd)
}

// --- mutable byte buffer (for the bithash table) ---
extern zsync_buf_alloc(n: long) -> ptr
// Same allocator, char*-returning, for callers that wrap it with
// string_new_with_length (avoids a ptr->string `as` cast, which the
// language doesn't permit).
extern zsync_buf_alloc_str(n: long) -> string
extern zsync_buf_get(b: ptr, i: long) -> int
extern zsync_buf_set(b: ptr, i: long, v: int)
extern zsync_buf_or(b: ptr, i: long, v: int)
extern zsync_buf_free(b: ptr)

buf_alloc(n: int) -> ptr {
    return zsync_buf_alloc(n)
}

// Allocate a zeroed buffer of n bytes, returned as a length-aware
// Aether string of length n.
buf_alloc_str(n: int) -> string {
    return string_new_with_length(zsync_buf_alloc_str(n), n)
}

buf_get(b: ptr, i: int) -> int {
    return zsync_buf_get(b, i)
}

buf_set(b: ptr, i: int, v: int) {
    zsync_buf_set(b, i, v)
}

buf_or(b: ptr, i: int, v: int) {
    zsync_buf_or(b, i, v)
}

buf_free(b: ptr) {
    zsync_buf_free(b)
}

// Wrap an existing byte buffer (ptr) as a length-aware string of n
// bytes, copying via string_new_with_length. Used after mutating a
// buf_alloc'd buffer with buf_set.
buf_to_str(b: ptr, n: int) -> string {
    s = string_new_with_length(buf_as_string(b), n)
    // Retain so the heap-string tracker doesn't free it when the
    // producing function returns — these buffers get stored into
    // malloc'd structs (HashEntry.md4) the tracker can't see.
    string_retain(s)
    return s
}

// Copy `src` (src_len bytes) but with the first `prefix` bytes zeroed.
// Used by tests to fabricate a partial seed.
zero_prefix(src: string, src_len: int, prefix: int) -> string {
    out = zsync_buf_alloc(src_len)
    i = 0
    while i < src_len {
        if i < prefix {
            zsync_buf_set(out, i, 0)
        } else {
            zsync_buf_set(out, i, string_char_at_n(src, src_len, i) & 0xff)
        }
        i = i + 1
    }
    return string_new_with_length(buf_as_string(out), src_len)
}

// Copy `rem` bytes of `src` at `start` into a fresh `blocksize`-byte
// buffer, zero-padding the tail. For the short last block of a download.
pad_block(src: string, src_len: int, start: int, rem: int, blocksize: int) -> string {
    out = zsync_buf_alloc(blocksize)
    i = 0
    while i < rem {
        zsync_buf_set(out, i, string_char_at_n(src, src_len, start + i) & 0xff)
        i = i + 1
    }
    return string_new_with_length(buf_as_string(out), blocksize)
}

// Binary-safe substring: copy bytes [start, start+len) of a length-aware
// buffer `src` (total length src_len) into a fresh length-aware string.
// std's string_substring is strlen-based and TRUNCATES at the first NUL,
// so it cannot be used on binary block data.
slice(src: string, src_len: int, start: int, len: int) -> string {
    out = zsync_buf_alloc(len)
    i = 0
    while i < len {
        zsync_buf_set(out, i, string_char_at_n(src, src_len, start + i) & 0xff)
        i = i + 1
    }
    return string_new_with_length(buf_as_string(out), len)
}

// ptr-typed buffer re-typed as string (identity at the C level).
extern zsync_buf_identity(b: ptr) -> string
buf_as_string(b: ptr) -> string {
    return zsync_buf_identity(b)
}

// RFC1123Z formatting of a Unix epoch (UTC), for zsync's MTime header.
// std only formats "now" as ISO-8601, so this covers arbitrary epochs.
extern zsync_rfc1123z(epoch: long) -> string
extern zsync_parse_rfc1123(s: string) -> long

rfc1123z(epoch: int) -> string {
    return zsync_rfc1123z(epoch)
}

parse_rfc1123(s: string) -> int {
    return zsync_parse_rfc1123(s)
}

// Set `path`'s modification time to `epoch` (Unix seconds, UTC). std.fs
// can read mtime but not set it. Returns 0 on success, -1 on failure.
extern zsync_set_mtime(path: string, epoch: long) -> int
set_mtime(path: string, epoch: int) -> int {
    return zsync_set_mtime(path, epoch)
}

// Persistently copy 16 bytes out of a buf into a fresh, process-lifetime
// buffer returned as a length-16 string. Use this (not buf_to_str) for
// values stashed into long-lived structs (target-block MD4s) — it does
// not go through the heap-string tracker, which was recycling buffers.
// Returns a raw malloc'd char* (typed string) — deliberately NOT an
// AetherString, so the heap-string tracker treats it as borrowed and
// never frees/recycles it. This is what target-block MD4s need: they
// live for the whole run inside untracked malloc'd HashEntry structs,
// and going through string_new_with_length had the tracker recycling
// the backing buffers (cross-linking block checksums).
extern zsync_dup16(b: ptr) -> string
dup16(b: ptr) -> string {
    return zsync_dup16(b)
}
